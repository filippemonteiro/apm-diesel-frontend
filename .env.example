# Configuração da API Backend Laravel
# URL base da API - ajuste conforme seu ambiente
#VITE_API_URL=https://api.controllcar.com.br/api

# Para desenvolvimento local, use:
# VITE_API_URL=http://localhost:8000/api

# Configurações adicionais (opcionais)
VITE_APP_NAME="APM Diesel"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Sistema de Controle de Frota"

# Timeout da API (em milissegundos)
VITE_API_TIMEOUT=15000

# Configuração de ambiente
VITE_NODE_ENV=production

# Para desenvolvimento local:
# VITE_NODE_ENV=development